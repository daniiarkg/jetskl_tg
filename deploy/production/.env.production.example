# Application secrets. Copy to .env.production and keep permissions restricted.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/app/.sessions/leadfinder
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_LLM_MODEL=gemini-3.7-flash

# Dashboard authentication and Telegram notification bot.
ADMIN_API_KEY=
TELEGRAM_NOTIFICATION_BOT_TOKEN=
TELEGRAM_NOTIFICATION_ACCESS_KEY=

# Runtime.
DATABASE_URL=postgresql+psycopg://leadfinder:CHANGE_ME@db:5432/leadfinder
POSTGRES_PASSWORD=CHANGE_ME
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DASHBOARD_PUBLIC_URL=https://leads.example.com
MONITOR_INTERVAL_SECONDS=60
MONITOR_MESSAGES_PER_SOURCE=200
SIGNAL_STORE_THRESHOLD=0.35
LEAD_CANDIDATE_THRESHOLD=0.55
AUTO_CREATE_LEADS=false
NOTIFICATION_DELIVERY_BATCH=50
NOTIFICATION_MAX_ATTEMPTS=8
