TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=.sessions/leadfinder
# Vercel uses a Sensitive TELEGRAM_SESSION_STRING instead of a file-session.
# TELEGRAM_SESSION_STRING=

# SQLite works locally. For production use the PostgreSQL URL from docker-compose.yml.
DATABASE_URL=sqlite:///data/leadfinder.db
# DATABASE_URL=postgresql+psycopg://leadfinder:leadfinder@localhost:5432/leadfinder

DISCOVERY_MAX_QUERIES=120
DISCOVERY_RESULTS_PER_QUERY=20
DISCOVERY_MESSAGE_LOOKBACK_DAYS=30
DISCOVERY_SOURCE_SAMPLE_MESSAGES=50
MONITOR_INTERVAL_SECONDS=60
MONITOR_MESSAGES_PER_SOURCE=200
SIGNAL_STORE_THRESHOLD=0.35
LEAD_CANDIDATE_THRESHOLD=0.55
AUTO_CREATE_LEADS=false
MAX_SIGNAL_TEXT_LENGTH=4000

# Required: every classification uses Gemini embeddings and Gemini structured output.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_LLM_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=45

SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Required before exposing the API beyond localhost.
ADMIN_API_KEY=

# Telegram Bot API token from @BotFather and a subscriber access key.
# Unless ADMIN_API_KEY is set, this access key also protects the dashboard.
# Neither value is stored in the database or returned by the API.
TELEGRAM_NOTIFICATION_BOT_TOKEN=
TELEGRAM_NOTIFICATION_ACCESS_KEY=
NOTIFICATION_DELIVERY_BATCH=50
NOTIFICATION_MAX_ATTEMPTS=8
# Freshness gate: hot <= 7d, active <= 30d, 31-90d only with a future event date.
LEAD_HOT_MAX_AGE_DAYS=7
LEAD_ACTIVE_MAX_AGE_DAYS=30
LEAD_REVIEW_MAX_AGE_DAYS=90
# Historical backfill stores evidence but does not alert operators by default.
BACKFILL_NOTIFICATIONS_ENABLED=false
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8000
